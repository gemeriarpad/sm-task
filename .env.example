APP_NAME="GitHub Repository Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Where alerts for failed queue jobs go (storage/logs/alerts.log by default), e.g.
# "alerts_file,slack" together with LOG_SLACK_WEBHOOK_URL.
LOG_ALERT_CHANNELS=alerts_file

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live sync updates: `php artisan reverb:install` generates local Reverb keys and
# switches this to "reverb". With "log" the pages fall back to polling.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Optional GitHub personal access token (no scopes needed for public data).
# Raises the API rate limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Cron expression for the scheduled resync of all targets (default: hourly).
GITHUB_SYNC_SCHEDULE="0 * * * *"

# Repositories larger than this (GitHub reported size) are not cloned.
GITHUB_CLONE_MAX_SIZE_MB=512

# Where clones are stored, one folder per GitHub repository id (default: storage/app/clones).
# GITHUB_CLONE_PATH=
